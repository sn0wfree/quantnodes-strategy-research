# strategy-research 数据源 Token 配置
# 复制此文件为 .env 并填入你的 token

# Tushare (A 股/ETF/指数/港股)
# 获取: https://tushare.pro/register
TUSHARE_TOKEN=

# iFinD MCP (宏观/港美股)
# 获取: https://www.51ifind.com
IFIND_MCP_TOKEN=

# 允许 chat 智能体使用 run_command 工具（bash/python）。
# 服务启动时从进程 cwd 的 .env 加载（LLMConfig.load → dotenv），
# 生产环境放在 /home/ll/Public/qn-research/.env。
SR_ALLOW_SHELL_TOOLS=1

# FRED (美国宏观数据)
# 获取: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
