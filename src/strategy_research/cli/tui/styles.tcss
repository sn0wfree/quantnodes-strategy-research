/* Textual CSS for the QuantNodes-Research TUI.
 *
 * Layout:
 *   Screen
 *     ├─ StatusHeader  (top, height 1 - model, tokens, ctx, stats)
 *     ├─ #main-row  (horizontal split, fills)
 *     │    ├─ #sidebar  (26 cols, hidden by default, Ctrl+1)
 *     │    ├─ #transcript  (1fr - persistent chat log, no max_lines)
 *     │    └─ #rail  (36 cols - goal + timeline, Ctrl+2)
 *     ├─ ThinkingSpinner  (height 1 - spinner, hidden when idle)
 *     ├─ #input  (height 3 - bottom prompt)
 *     └─ HintFooter  (1 row - hint bar / status)
 *
 * Streaming + fold happen inside TranscriptView (no separate widget).
 * Ctrl+E toggles fold/expand of the most recent folded record.
 * ToolsRail shows a unified timeline (vibe-trading style).
 *
 * See docs/tui-display-philosophy.md for design principles.
 */

Screen {
    layout: vertical;
    background: $surface;
}

StatusHeader {
    dock: top;
    height: 1;
    background: $primary 25%;
    color: $text;
    padding: 0 1;
}

#main-row {
    layout: horizontal;
    height: 1fr;
    background: $surface;
}

#sidebar {
    width: 26;
    border: round $primary;
    border-title-align: left;
    background: $primary 8%;
    padding: 0 1;
}

#sidebar.hidden {
    display: none;
}

#transcript {
    width: 1fr;
    border: round $primary;
    border-title-align: left;
    background: $surface;
    padding: 0 1;
}

#rail {
    width: 36;
    border: round $primary;
    border-title-align: left;
    background: $primary 8%;
    padding: 0 1;
}

#rail.hidden {
    display: none;
}

#input {
    height: 3;
    border: round $primary;
    border-title-align: left;
    background: $surface;
}

.sidebar-item {
    height: 1;
    padding: 0 1;
}

.sidebar-item.--highlight {
    background: $primary 30%;
    text-style: bold;
}

.transcript-line {
    height: auto;
    color: $text;
}

.transcript-line.system {
    color: $secondary;
}

.transcript-line.user {
    color: $text;
    text-style: bold;
}

.transcript-line.assistant {
    color: $success;
}

.transcript-line.error {
    color: $error;
    text-style: bold;
}

.rail-event.tool-call {
    color: $accent;
}

.rail-event.tool-result-ok {
    color: $success;
}

.rail-event.tool-result-error {
    color: $error;
}

.rail-event.thinking {
    color: $text-muted;
    text-style: italic;
}

HintFooter {
    dock: bottom;
    height: 1;
    background: $primary 15%;
    color: $text;
}
