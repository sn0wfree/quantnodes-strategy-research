#!/bin/sh
# pre-commit: block syntax errors and undefined names in staged .py files.
#
# Deliberately narrow scope (see docs/p0-guardrails-design.md §1.2):
#   E9   — syntax errors
#   F821 — undefined-name (the class of bug that escaped to main in 3bdde1d)
#
# F811 is NOT checked yet: 4 pre-existing hits in core/autoresearch.py
# would lock every commit touching that file. Add it after the P1.5
# cleanup batch clears them.
#
# Only files staged in THIS commit are checked, so pre-existing issues
# elsewhere never block unrelated work. Enable with:
#   sh scripts/install-hooks.sh

set -e

files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

if [ -z "$files" ]; then
    exit 0
fi

# ruff missing = warn and pass (CI still enforces); never hard-fail on
# a missing local tool for contributors who have not set up dev deps.
if ! command -v ruff >/dev/null 2>&1 && ! python -m ruff --version >/dev/null 2>&1; then
    echo "pre-commit: ruff not found on PATH or as a module; skipping lint (CI will still check)." >&2
    exit 0
fi

if command -v ruff >/dev/null 2>&1; then
    RUFF="ruff check"
else
    RUFF="python -m ruff check"
fi

# shellcheck disable=SC2086
if ! $RUFF --select E9,F821 --quiet $files; then
    echo "" >&2
    echo "pre-commit: blocked — fix the errors above (E9 syntax / F821 undefined name)." >&2
    echo "  tip: run '$RUFF --select E9,F821 <file>' to re-check after fixing." >&2
    exit 1
fi

exit 0
