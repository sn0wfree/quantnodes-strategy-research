{"id": "factor-ic-check", "prompt": "使用 compute_factor 计算 ts_return(close,20) 动量因子，再用 factor_analysis 给出 IC 与 IC_IR，结论里必须包含 IC 字样", "expected_tools": ["compute_factor", "factor_analysis"], "forbidden_tools": ["write", "run_backtest", "run_bg_command"], "toolset": "factor_analyst", "must_contain": ["IC|信息系数|rank_ic|ic_ir"], "tags": ["factor"]}
